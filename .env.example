# Optional stable session encryption secret (required on Vercel).
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LWC_SECRET=

# Persistent server session directory. Never commit it or serve it publicly.
# OMA_AUTH_DIR=/absolute/path/to/oma-auth

# Shared session store for serverless ChatGPT login. Both plus LWC_SECRET required.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Real Chromium: automatic on localhost development; opt in on a private production host.
# OMA_BROWSER_ENABLED=1

# Optional external Chromium on a persistent Node deployment (not Vercel).
# The external browser must use a reachable public-only egress proxy.
# OMA_BROWSER_CDP_URL=
# OMA_BROWSER_PROXY_URL=
